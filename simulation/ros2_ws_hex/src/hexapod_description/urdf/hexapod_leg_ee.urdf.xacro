<?xml version="1.0"?>
 
 <robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 
   <xacro:property name="base_mass" value="4.6" />
   <xacro:property name="wheel_mass" value="1.0" />
   <xacro:property name="ixx" value="1.0"/>
   <xacro:property name="iyy" value="1.0"/>
   <xacro:property name="izz" value="1.0"/>
 
   <xacro:macro name="hexapod" params="prefix=''">
 
     <xacro:property
       name="meshes_file_direction"
       value="package://hexapod_description/meshes"/>
 

<!-- WORLD DEFINITION -->
      <!-- <link name="world"/> -->
      <!-- 

      <joint name="${prefix}world_fixed" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="${prefix}base_link"/>
      </joint> -->

<!-- PLATFORMA -->
      
     <link name="${prefix}base_link">
       <visual>
         <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/platform.stl" scale="1.0 1.0 1.0"/>
         </geometry>
         <material name="grey">
           <color rgba="0.2 0.2 0.2 1"/>
         </material>
       </visual>
 
       <collision>
         <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/hitbox_platform.stl" scale="1.0 1.0 1.0"/>
         </geometry>
       </collision>
 
        <inertial>
         <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
         <mass value="${base_mass}"/>
         <inertia
           ixx="${ixx}" ixy="0.0" ixz="0.0"
           iyy="${iyy}" iyz="0.0"
           izz="${izz}"/>
       </inertial>
     </link>


  <!-- LEG 1!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
 
     <!-- PLATFORMA - UP_SECTION -->
 
     <joint name="${prefix}joint1_1" type="revolute">
       <parent link="${prefix}base_link"/>
       <child link="${prefix}link2_1"/>
       <origin xyz="-0.063746	0.067285	0.003274" rpy="0 0 0"/>
       <axis xyz="0.0 0.0 1.0"/>
       <limit effort="5.0" velocity="1.0" lower="-0.5236" upper="0.5236"/>
       <dynamics damping="0.1"/>
     </joint>
 
   <!-- UP_SECTION -->
 
     <link name="${prefix}link2_1">
       <visual>
         <origin xyz="-0.013611	0.016988 -0.000419" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/1_leg_up.stl" scale="1.0 1.0 1.0"/>
         </geometry>
         <material name="grey">
           <color rgba="0.2 0.2 0.2 1"/>
         </material>
       </visual>
 
       <collision>
         <origin xyz="-0.013611	0.016988 -0.000419" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/hitbox_1_leg_up.stl" scale="1.0 1.0 1.0"/>
         </geometry>
       </collision>
 
        <inertial>
         <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
         <mass value="${wheel_mass}"/>
         <inertia
           ixx="${ixx}" ixy="0.0" ixz="0.0"
           iyy="${iyy}" iyz="0.0"
           izz="${izz}"/>
       </inertial>
     </link>
 
     <!-- UP_SECTION - MID_SECTION -->
 
     <joint name="${prefix}joint2_1" type="revolute">
      <parent link="${prefix}link2_1"/>
      <child link="${prefix}link3_1"/>
      <origin xyz="-0.018864	0.024671	-0.020002" rpy="0 0 0"/>
      <axis xyz="-0.6074290528 -0.794374 0"/>
      <limit effort="5.0" velocity="1.0" lower="-0.261799388" upper="1.308996939"/>
      <dynamics damping="0.1"/>
    </joint>

  <!-- MID_SECTION -->

    <link name="${prefix}link3_1">
      <visual>
        <origin xyz="-0.024936	0.032658	0.000547" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/1_leg_mid.stl" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="grey">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="-0.024936	0.032658	0.000547" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${meshes_file_direction}/hitbox_1_leg_mid.stl" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>

       <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${ixx}" ixy="0.0" ixz="0.0"
          iyy="${iyy}" iyz="0.0"
          izz="${izz}"/>
      </inertial>
    </link>

  <!-- MID_SECTION - DOWN_SECTION -->

    <joint name="${prefix}joint3_1" type="revolute">
      <parent link="${prefix}link3_1"/>
      <child link="${prefix}link4_1"/>
      <origin xyz="-0.054636	0.071451	0.00505" rpy="1.4072 0 0"/>
      <axis xyz="-0.6074290528 -0.794374 0"/>
      <limit effort="5.0" velocity="1.0" lower="0" upper="1.570796327"/>
      <dynamics damping="0.1"/>
    </joint>

  <!-- DOWN_SECTION -->

    <link name="${prefix}link4_1">
      <visual>
        <origin xyz="-0.039176	0.05167	0" rpy="0 0 0"/>
        <geometry>
