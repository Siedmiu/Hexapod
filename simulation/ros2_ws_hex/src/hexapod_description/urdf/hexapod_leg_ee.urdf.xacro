        <geometry>
          <mesh filename="${meshes_file_direction}/hitbox_1_leg_down.stl" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision>

        <inertial>
        <origin xyz="0.0        0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${ixx}" ixy="0.0" ixz="0.0"
          iyy="${iyy}" iyz="0.0"
          izz="${izz}"/>
      </inertial>
    </link>

    <!-- END EFFECTOR JOINT AND LINK -->

    <joint name="${prefix}joint4_1" type="fixed">
      <parent link="${prefix}link4_1"/>
      <child link="${prefix}link5_1"/>
      <origin xyz="-0.099587	0.130461	-0.000046" rpy="0 0 0"/>
    </joint>
    
    <link name="${prefix}link5_1"/>

