<?xml version="1.0"?>
 
 <robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 
   <xacro:property name="base_mass" value="4.6" />
   <xacro:property name="wheel_mass" value="1.0" />
   <xacro:property name="ixx" value="1.0"/>
   <xacro:property name="iyy" value="1.0"/>
   <xacro:property name="izz" value="1.0"/>
 
   <xacro:macro name="open_manipulator_x" params="prefix=''">
 
     <xacro:property
       name="meshes_file_direction"
       value="package://open_manipulator_description/meshes"/>
 


<!-- PLATFORMA -->
 
     <link name="${prefix}link1">
       <visual>
         <origin xyz="-0.001140 0.000016 -0.002812" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/platform.stl" scale="1.0 1.0 1.0"/>
         </geometry>
         <material name="grey">
           <color rgba="0.2 0.2 0.2 1"/>
         </material>
       </visual>
 
       <collision>
         <origin xyz="0 0 0" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/platform.stl" scale="1.0 1.0 1.0"/>
         </geometry>
       </collision>
 
        <inertial>
         <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
         <mass value="${base_mass}"/>
         <inertia
           ixx="${ixx}" ixy="0.0" ixz="0.0"
           iyy="${iyy}" iyz="0.0"
           izz="${izz}"/>
       </inertial>
     </link>


  <!-- LEG 1!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
 
     <!-- PLATFORMA - UP_SECTION -->
 
     <joint name="${prefix}joint1_1" type="revolute">
       <parent link="${prefix}link1"/>
       <child link="${prefix}link2_1"/>
       <origin xyz="-0.062614  0.067285   0.00596" rpy="0 0 0"/>
       <axis xyz="0.0 0.0 1.0"/>
       <limit effort="5.0" velocity="1.0" lower="-0.5236" upper="0.5236"/>
       <dynamics damping="0.1"/>
     </joint>
 
   <!-- UP_SECTION -->
 
     <link name="${prefix}link2_1">
       <visual>
         <origin xyz="-0.013611	0.016988 -0.000419" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/1_leg_up.stl" scale="1.0 1.0 1.0"/>
         </geometry>
         <material name="grey">
           <color rgba="0.2 0.2 0.2 1"/>
         </material>
       </visual>
 
       <collision>
         <origin xyz="0	0.001689	0.000952" rpy="0 0 0"/>
         <geometry>
           <mesh filename="${meshes_file_direction}/1_leg_up.stl" scale="1.0 1.0 1.0"/>
         </geometry>
       </collision>
 
        <inertial>
         <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
         <mass value="${wheel_mass}"/>
         <inertia
           ixx="${ixx}" ixy="0.0" ixz="0.0"
           iyy="${iyy}" iyz="0.0"
           izz="${izz}"/>
       </inertial>
     </link>
 
   <!-- UP_SECTION - MID_SECTION -->
 
     <joint name="${prefix}joint2_1" type="revolute">
       <parent link="${prefix}link2_1"/>
       <child link="${prefix}link3_1"/>
