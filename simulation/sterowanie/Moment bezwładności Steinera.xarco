<?xml version="1.0"?>
<robot name="hexapod_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parametry masy i przesunięcia -->
  <xacro:property name="mass" value="1.0"/>  <!-- Przykładowa masa, możesz zmienić -->
  <xacro:property name="dx" value="0.1"/>    <!-- Przykładowe przesunięcie dx -->
  <xacro:property name="dy" value="0.2"/>    <!-- Przykładowe przesunięcie dy -->
  <xacro:property name="dz" value="0.3"/>    <!-- Przykładowe przesunięcie dz -->

  <!-- Moment bezwładności Steinera -->
  <xacro:property name="Ixx" value="((<xacro:eval value="${dy*dy + dz*dz}"/>))"/>
  <xacro:property name="Iyy" value="((<xacro:eval value="${dx*dx + dz*dz}"/>))"/>
  <xacro:property name="Izz" value="((<xacro:eval value="${dx*dx + dy*dy}"/>))"/>
  
  <xacro:property name="Ixy" value="(-dx * dy)"/>
  <xacro:property name="Ixz" value="(-dx * dz)"/>
  <xacro:property name="Iyz" value="(-dy * dz)"/>

  <!-- Definicja linku z momentem bezwładności -->
  <link name="body">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${Ixx}"
        ixy="${Ixy}"
        ixz="${Ixz}"
        iyy="${Iyy}"
        iyz="${Iyz}"
        izz="${Izz}"
      />
    </inertial>
  </link>

</robot>